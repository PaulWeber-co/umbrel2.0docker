# Copy to /etc/xps-homeserver/ambient.env and tune only if needed.
XPS_CAMERA_DEVICE=/dev/video0
# Optional directory, for example /sys/class/backlight/intel_backlight
XPS_BACKLIGHT_PATH=
XPS_AMBIENT_INTERVAL=10
# Hysteresis thresholds in 0..255 grayscale levels.
XPS_AMBIENT_DARK_ON=16
XPS_AMBIENT_DARK_OFF=25
XPS_BACKLIGHT_MIN_PERCENT=8
XPS_BACKLIGHT_MAX_PERCENT=85
XPS_BACKLIGHT_GAMMA=0.65
