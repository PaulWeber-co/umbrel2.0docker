# Kopiere diese Datei nach .env und trag deine Werte ein:
#
#   cp .env.example .env
#
# .env steht in .gitignore und landet nie im Repo. Werte ohne Anführungszeichen
# schreiben; alles nach dem ersten "=" gilt, auch Leerzeichen und Sonderzeichen.

# --- Gerät -------------------------------------------------------------------

# Name im Netzwerk, erreichbar als <name>.local
XPS_HOSTNAME=xps
# Benutzer auf dem XPS (Kleinbuchstaben, keine Leerzeichen)
XPS_USER=paul
XPS_FULLNAME=Paul
# Passwort für die Anmeldung direkt am Gerät. Leer lassen: build.sh fragt dann
# beim Bauen danach, und es wird nirgends gespeichert (empfohlen).
XPS_PASSWORD=
# Öffentlicher SSH-Schlüssel vom Mac. Damit meldest du dich ohne Passwort an;
# Passwort-Login per SSH ist von Anfang an aus.
XPS_SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub

# --- WLAN (Speedport) ----------------------------------------------------------

# Der Broadcom-Treiber kann kein reines WPA3. Im Speedport "WPA2/WPA3" (Mischmodus)
# oder "WPA2" eingestellt lassen.
XPS_WIFI_SSID=
XPS_WIFI_PSK=

# --- Umbrel-Container --------------------------------------------------------

# Image, das der GitHub-Workflow aus diesem Fork baut und nach GHCR pusht.
XPS_UMBREL_IMAGE_REPOSITORY=ghcr.io/paulweber-co/xps-homeserver-umbrelos

# --- Region --------------------------------------------------------------------

XPS_TIMEZONE=Europe/Berlin
XPS_LOCALE=de_DE.UTF-8
XPS_KEYMAP=de
