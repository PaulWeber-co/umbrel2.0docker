# Kopiere diese Datei nach .env und trag deine Werte ein:
#
#   cp .env.example .env
#
# .env steht in .gitignore und landet nie im Repo. Werte ohne Anführungszeichen
# schreiben; alles nach dem ersten "=" gilt, auch Leerzeichen und Sonderzeichen.

# --- Gerät -------------------------------------------------------------------

# Name im Netzwerk, erreichbar als <name>.local
XPS_HOSTNAME=xps
# Benutzer auf dem XPS (Kleinbuchstaben, keine Leerzeichen)
XPS_USER=paul
XPS_FULLNAME=Paul
# Passwort für die Anmeldung direkt am Gerät. Leer lassen: build.sh fragt dann
# beim Bauen danach, und es wird nirgends gespeichert (empfohlen).
XPS_PASSWORD=
# Öffentlicher SSH-Schlüssel vom Mac. Damit meldest du dich ohne Passwort an;
# Passwort-Login per SSH ist von Anfang an aus.
XPS_SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub

# --- WLAN (Speedport) ----------------------------------------------------------

# Der Broadcom-Treiber kann kein reines WPA3. Im Speedport "WPA2/WPA3" (Mischmodus)
# oder "WPA2" eingestellt lassen.
XPS_WIFI_SSID=
XPS_WIFI_PSK=

# --- Region --------------------------------------------------------------------

XPS_TIMEZONE=Europe/Berlin
XPS_LOCALE=de_DE.UTF-8
XPS_KEYMAP=de

# =============================================================================
# Dashboard (http://xps.local:7777). Fehlt bei einem Widget eine Pflicht-
# Einstellung, zeigt es Beispieldaten mit dem Hinweis "Beispieldaten".
# =============================================================================

# Begrüßung "Guten Morgen, <Name>"
DASH_NAME=Paul
# Ort für Wetter, Sonnenauf- und -untergang
DASH_PLACE=Hamburg
DASH_LAT=53.55
DASH_LON=10.00
DASH_TIMEZONE=Europe/Berlin

# --- Arbeitsweg (TomTom, kostenlos bis 2.500 Anfragen am Tag; das Widget
#     braucht etwa 42 pro Werktag). Schlüssel: developer.tomtom.com
DASH_TOMTOM_KEY=
DASH_HOME_ADDRESS=
DASH_WORK_ADDRESS=
# Statt Adressen auch Koordinaten "Breite,Länge" (haben Vorrang)
DASH_HOME_COORDS=
DASH_WORK_COORDS=
# Wochentage (Mo = 1) und Zeitfenster, in dem die Fahrzeit abgefragt wird
DASH_COMMUTE_DAYS=1-5
DASH_COMMUTE_FROM=06:00
DASH_COMMUTE_TO=09:30
DASH_COMMUTE_LABEL=Ins Büro

# --- Fotos (Immich auf dem Umbrel; API-Schlüssel in Immich unter
#     Kontoeinstellungen → API-Schlüssel, für den Speicherplatz als Admin)
DASH_IMMICH_URL=http://umbrel.local:2283
DASH_IMMICH_KEY=

# --- Zuhause (Home Assistant auf dem Umbrel; Token im HA-Profil unter
#     "Langlebige Zugriffstoken")
DASH_HA_URL=http://umbrel.local:8123
DASH_HA_TOKEN=
# Entitäten in Anzeigereihenfolge, optional mit eigenem Namen nach "="
DASH_HA_ENTITIES=light.wohnzimmer=Wohnzimmer,sensor.wohnzimmer_temperatur=innen

# --- Server: Umbrel-Apps über Umbrels MCP-Schnittstelle (umbrelOS →
#     Einstellungen → KI-Agenten (MCP) → Zugangsschlüssel; keine Freigaben
#     nötig). Ohne Schlüssel zeigt die Kachel nur die Werte des XPS.
DASH_UMBREL_URL=http://127.0.0.1
DASH_UMBREL_TOKEN=

# --- Kalender: ICS-Adressen, mehrere mit Leerzeichen getrennt
#     (iCloud: Kalender teilen → "Öffentlicher Kalender", webcal:// geht)
DASH_ICS_URLS=
