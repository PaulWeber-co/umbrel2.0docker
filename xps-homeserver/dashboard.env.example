# Einstellungen des Wand-Dashboards. Auf dem XPS liegen sie in
# /etc/xps-homeserver/dashboard.env (setup-xps.sh legt die Datei an):
#
#   sudoedit /etc/xps-homeserver/dashboard.env
#   sudo systemctl restart xps-dashboard
#
# Zum Ausprobieren auf dem Mac: cp dashboard.env.example dashboard.env, dann
# in dashboard/ "npm start". Beide Dateien kommen nie ins Repo. Fehlt einem
# Widget eine Pflicht-Einstellung, zeigt es Beispieldaten mit der Marke
# "Beispiel" in der Kachel. Werte ohne Anführungszeichen schreiben.

# Ort für Wetter (Open-Meteo, ohne Schlüssel), Sonnenauf- und -untergang
DASH_PLACE=Hamburg
DASH_LAT=53.55
DASH_LON=10.00
DASH_TIMEZONE=Europe/Berlin
# Startwert des Glas-Reglers (0 klar … 100 milchig); danach gilt der Regler
DASH_GLASS=55

# --- Zugriff. Ansehen geht im Heimnetz ohne Anmeldung. Mit einer PIN braucht
#     jede Änderung von einem anderen Gerät (Handy, Mac, Tailscale) einmal pro
#     Browser die PIN: Licht schalten, To-dos, Kacheln, Steuerung. Der Kiosk
#     am XPS selbst fragt nie. Empfohlen, sobald Gäste in deinem WLAN sind.
DASH_PIN=
# Eigene Hostnamen, unter denen du das Dashboard aufrufst, kommagetrennt.
# Schon erlaubt: IP-Adressen, xps, *.local, *.fritz.box, *.speedport.ip,
# *.ts.net (Tailscale) und ähnliche Heimnetz-Namen. Andere Namen werden
# abgewiesen (Schutz gegen DNS-Rebinding fremder Webseiten).
DASH_ALLOWED_HOSTS=

# --- Arbeitsweg mit Stau (TomTom, kostenlos bis 2.500 Anfragen am Tag; das
#     Widget braucht etwa 42 pro Werktag). Schlüssel: developer.tomtom.com
DASH_TOMTOM_KEY=
DASH_HOME_ADDRESS=
DASH_WORK_ADDRESS=
# Statt Adressen auch Koordinaten "Breite,Länge" (haben Vorrang)
DASH_HOME_COORDS=
DASH_WORK_COORDS=
# Wochentage (Mo = 1) und Zeitfenster, in dem die Fahrzeit abgefragt wird
DASH_COMMUTE_DAYS=1-5
DASH_COMMUTE_FROM=06:00
DASH_COMMUTE_TO=09:30
DASH_COMMUTE_LABEL=Ins Büro

# --- Fotos (Immich auf dem Umbrel). API-Schlüssel in Immich unter
#     Kontoeinstellungen → API-Schlüssel; für den Speicherplatz als Admin.
DASH_IMMICH_URL=http://umbrel.local:2283
DASH_IMMICH_KEY=

# --- Home Assistant auf dem Umbrel: Zuhause, Kalender, To-dos. Token im
#     HA-Profil → Sicherheit → "Langlebige Zugriffstoken".
DASH_HA_URL=http://umbrel.local:8123
DASH_HA_TOKEN=
# Zuhause: Entitäten in Anzeigereihenfolge, optional mit Namen nach "=", z. B.
#   light.wohnzimmer=Wohnzimmer,sensor.wohnzimmer_temperatur=innen
#   (die genauen Namen: HA → Einstellungen → Geräte & Dienste → Entitäten)
DASH_HA_ENTITIES=
# Kalender: eine Kalender-Entität, z. B. ein Google-Kalender in HA (Apple-Kalender
#   gehen ohne HA, siehe DASH_CALENDAR_ICS unten)
DASH_HA_CALENDAR_ENTITY=
# To-dos: eine Listen-Entität, z. B. todo.einkaufsliste
DASH_HA_TODO_ENTITY=

# --- Apple-Kalender, ohne Home Assistant: in der Kalender-App beim Kalender
#     (iPhone: Kalender → ⓘ, Mac: Rechtsklick → Teilen) "Öffentlicher
#     Kalender" einschalten und den webcal://-Link eintragen, mehrere durch
#     Kommas getrennt. Wer den Link kennt, kann den Kalender lesen: nur hier
#     eintragen. Läuft zusammen mit DASH_HA_CALENDAR_ENTITY, wenn beide gesetzt sind.
DASH_CALENDAR_ICS=

# --- Apple Erinnerungen auf der To-do-Kachel: der Name einer Liste, z. B.
#     Einkauf. Ein Kurzbefehl auf dem iPhone gleicht sie ab (docs/betrieb.md,
#     "Erinnerungen"). Gesetzt, ersetzt sie DASH_HA_TODO_ENTITY.
DASH_REMINDERS_LIST=

# --- Minifunk: kurze Nachrichten, Listen und ein Foto am Tag aus der
#     Knuddl-App (Wir → Heute → Minifunk) erscheinen links unter der Uhr,
#     solange keine Musik läuft. Die Einladung steht in Knuddl unter
#     Mehr → Verbindung und enthält euren gemeinsamen Schlüssel: wie ein
#     Passwort behandeln. Ohne Einladung ist Minifunk aus.
DASH_KNUDDL_INVITE=
DASH_KNUDDL_URL=https://chicken-702b6-default-rtdb.europe-west1.firebasedatabase.app
# Wie lange Text und Fotos an der Wand bleiben, in Stunden; Fotos werden
# danach vom XPS gelöscht (aus der Cloud schon beim Empfang).
DASH_MINIFUNK_HOURS=24
DASH_MINIFUNK_PHOTO_HOURS=6

# --- Dienste: Umbrel-Apps und eigene docker-compose-Projekte. Die Werte
#     sammelt xps-services.service; hier nur Namen und Ausblenden.
# Anzeigenamen, z. B. shop-api=Shop API,immich=Fotos
DASH_SERVICES_NAMES=
# Projekte, die nicht in der Kachel stehen sollen
DASH_SERVICES_HIDE=
