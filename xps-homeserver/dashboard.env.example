# Copy to /etc/xps-homeserver/dashboard.env and fill in the connections you use.
DASH_HOST=0.0.0.0
DASH_PORT=8080
DASH_NAME=
DASH_PLACE=Hamburg
DASH_LAT=53.55
DASH_LON=10.0
DASH_TIMEZONE=Europe/Berlin
DASH_DATA_DIR=/var/lib/xps-dashboard

# Home Assistant (Umbrel app URL or another reachable instance)
DASH_HA_URL=
DASH_HA_TOKEN=
DASH_HA_CALENDAR_ENTITY=
DASH_HA_TODO_ENTITY=
# Comma-separated entity IDs, for example light.living_room,switch.coffee
DASH_HA_HOME_ENTITIES=

# Immich photo and video statistics
DASH_IMMICH_URL=
DASH_IMMICH_API_KEY=
DASH_IMMICH_STATS_PATH=/api/server/statistics

# Driving-time estimate from OpenStreetMap's OSRM routing service.
# Coordinates use latitude,longitude; use an own OSRM server if preferred.
DASH_COMMUTE_ORIGIN=
DASH_COMMUTE_DESTINATION=
DASH_COMMUTE_DESTINATION_NAME=Arbeitsweg
DASH_OSRM_BASE_URL=https://router.project-osrm.org

# Shairport Sync metadata receiver on host loopback
DASH_MUSIC_UDP_PORT=5555

