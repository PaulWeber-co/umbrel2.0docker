# Einstellungen der Hintergrunddienste auf dem XPS. Optional: ohne Datei
# gelten die Standardwerte. Auf dem XPS: /etc/xps-homeserver/host.env, danach
# den betroffenen Dienst neu starten (sudo systemctl restart <dienst>).

# xps-wifi-watchdog: Ziel für den Netztest (Standard: der Router)
XPS_WATCHDOG_TARGET=
# xps-mdns-alias: weitere Namen für den XPS im Heimnetz, mit Leerzeichen
XPS_MDNS_ALIASES=umbrel.local
# xps-battery-care: Akku lädt nur bis hierhin (Prozent)
XPS_BATTERY_STOP=60

# xps-ambient: Webcam-Helligkeit. Messabstand hell / dunkel in Sekunden; die
# Kamera-LED leuchtet pro Messung etwa eine Sekunde.
XPS_AMBIENT_INTERVAL=45
XPS_AMBIENT_DARK_INTERVAL=120
# Dunkel ab / wieder hell ab (Graustufe 0 … 255, mit Abstand gegen Flackern)
XPS_AMBIENT_DARK_ON=16
XPS_AMBIENT_DARK_OFF=25
# Feste Belichtung (100-µs-Schritte) und Verstärkung der Webcam
XPS_CAMERA_EXPOSURE=156
XPS_CAMERA_GAIN=0
# Display-Helligkeit zwischen diesen Prozentwerten, Kurve per Gamma
XPS_BACKLIGHT_MIN_PERCENT=8
XPS_BACKLIGHT_MAX_PERCENT=85
XPS_BACKLIGHT_GAMMA=0.65

# xps-services: Abstand der Container-Messung in Sekunden
XPS_SERVICES_INTERVAL=30
