[Unit]
Description=Private XPS Umbrel container updater API
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=xps-umbrel-updater
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=xps-umbrel-updater
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/xps-homeserver/xps-homeserver/scripts/xps_update_service.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/xps-umbrel-updater /var/lib/xps-umbrel-updater

[Install]
WantedBy=multi-user.target
