[Unit]
Description=Install approved Umbrel container update %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/xps-homeserver/xps-homeserver/scripts/xps_update_worker.py --job %i
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/xps-homeserver /var/lib/xps-umbrel-updater /var/lib/docker/volumes
