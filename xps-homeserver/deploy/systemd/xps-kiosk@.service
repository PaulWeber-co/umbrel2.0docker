[Unit]
Description=XPS Design A wall dashboard kiosk for %i
After=network-online.target xps-dashboard.service
Wants=network-online.target
Requires=xps-dashboard.service
Conflicts=getty@tty1.service
ConditionPathExists=/opt/xps-homeserver/xps-homeserver/dashboard/server/index.js

[Service]
Type=simple
User=%i
PAMName=login
SupplementaryGroups=video input
Environment=HOME=%h
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=LIBSEAT_BACKEND=logind
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/bin/cage -s -- /usr/bin/chromium --kiosk --no-first-run --no-default-browser-check --disable-infobars --disable-session-crashed-bubble --disable-features=TranslateUI --user-data-dir=/var/lib/xps-kiosk http://127.0.0.1:8080
Restart=always
RestartSec=3
KillMode=mixed

[Install]
WantedBy=multi-user.target
